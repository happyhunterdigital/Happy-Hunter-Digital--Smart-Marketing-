rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // DEFENSE NODE 1: Cryptographic Admin Verification
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // DEFENSE NODE 2: App Check Verification
    function isVerifiedApp() {
      return request.token.app != null;
    }

    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;
    }

    match /workspace_tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /visual_audits/{docId} {
      allow create: if isVerifiedApp();
      allow read: if isVerifiedApp(); 
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /leads/{leadId} {
      allow create: if isVerifiedApp();
      allow read, update, delete: if request.auth != null;
    }

    match /prospects/{prospectId} {
      allow create: if isVerifiedApp();
      allow read, update, delete: if request.auth != null;
    }

    match /mail/{mailId} {
      allow create: if isVerifiedApp();
      allow read, update, delete: if false;
    }

    match /secure_access_sessions/{tokenId} {
      allow read, update: if true;
      allow create, delete: if false;
    }

    match /public_seo/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
