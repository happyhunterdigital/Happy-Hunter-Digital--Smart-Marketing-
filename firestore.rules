rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // PUBLIC LEAD CAPTURE: 
    // Anyone can create. Only Admins or the specific user can read.
    match /leads/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (
        request.auth.token.email == 'motsumitl@happyhunterdigital.com' || 
        request.auth.token.email == 'happyhunterdigital@gmail.com' ||
        request.auth.token.email == 'motsumitl@gmail.com' ||
        request.auth.token.email == 'Motsumitl@gmail.com' ||
        resource.data.email == request.auth.token.email
      );
    }
    
    // WHATSAPP TELEMETRY: 
    // Only authenticated Admins can see the high-value WhatsApp prospects.
    match /prospects/{document} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == 'motsumitl@happyhunterdigital.com' || 
        request.auth.token.email == 'happyhunterdigital@gmail.com' ||
        request.auth.token.email == 'motsumitl@gmail.com' ||
        request.auth.token.email == 'Motsumitl@gmail.com'
      );
    }
    
    // AI KNOWLEDGE BASE: 
    match /verified_claims/{document} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'motsumitl@happyhunterdigital.com' || 
        request.auth.token.email == 'happyhunterdigital@gmail.com' ||
        request.auth.token.email == 'motsumitl@gmail.com' ||
        request.auth.token.email == 'Motsumitl@gmail.com'
      );
    }
    
    // BRAND IDENTITY & PUBLIC SEO: 
    match /brand_identity/{document} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'motsumitl@happyhunterdigital.com' || 
        request.auth.token.email == 'happyhunterdigital@gmail.com' ||
        request.auth.token.email == 'motsumitl@gmail.com' ||
        request.auth.token.email == 'Motsumitl@gmail.com'
      );
    }

    // Allows authenticated users to claim their one-time WhatsApp token
    match /secure_access_sessions/{tokenId} {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    match /messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    
    match /reactions/{reactionId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /public_seo/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // WHATSAPP SESSION MEMORY (Chat history for the WhatsApp AI bot)
    // Written server-side by Cloud Functions (admin bypass). Block direct client access.
    match /whatsapp_sessions/{document} {
      allow read, write: if false;
    }

    // GLOBAL LOCKDOWN: 
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
