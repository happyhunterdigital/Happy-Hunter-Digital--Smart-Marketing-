rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin-only access
    match /audits/{auditId} {
      allow read: if request.auth != null && request.auth.token.email == "happyhunterdigital@gmail.com";
      allow create: if true; // Public can submit audits
      allow update, delete: if false;
    }
    
    // Public read-only config
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "happyhunterdigital@gmail.com";
    }
  }
}
