rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // HELPER: Global Admin Oversight
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'motsumitl@happyhunterdigital.com' ||
        request.auth.token.email.lower() == 'happyhunterdigital@gmail.com' ||
        request.auth.token.email.lower() == 'motsumitl@gmail.com'
      );
    }
    
    // 1. MULTI-TENANT WORKSPACES
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;
    }
    
    // 2. WORKSPACE TASK NODES
    match /workspace_tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    match /messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    
    match /reactions/{reactionId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /secure_access_sessions/{tokenId} {
      allow read, update: if request.auth != null;
      allow create, delete: if false;
    }

    match /public_seo/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
