rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // CORRECTED HELPER: Safely checks your array-based members field
    function isWorkspaceMember(workspaceData) {
      return request.auth != null && workspaceData.members.hasAny([request.auth.uid]);
    }

    match /workspaces/{workspaceId} {
      allow read: if isAdmin() || (resource != null && isWorkspaceMember(resource.data));
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && request.resource.data.members.hasAny([request.auth.uid]);
      allow update, delete: if isAdmin() || (resource != null && resource.data.ownerId == request.auth.uid);
    }

    match /workspace_tasks/{taskId} {
      // Fetches the workspace document to verify the array membership
      allow read: if isAdmin() || (resource != null && isWorkspaceMember(get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data));
      allow create: if request.auth != null && isWorkspaceMember(get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data);
      allow update, delete: if isAdmin() || (resource != null && resource.data.createdBy == request.auth.uid);
    }

    match /visual_audits/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // SECURITY: Only the Cloud Function should write here, via the Admin SDK —
    // which bypasses these rules entirely. The previous "allow create: if true"
    // let any visitor's browser write directly to this collection, which (if a
    // Trigger Email extension is listening) functioned as an open email relay.
    match /mail/{mailId} {
      allow create, read, update, delete: if false;
    }

    match /secure_access_sessions/{tokenId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /public_seo/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Note: A new "rate_limits" collection is used by performAudit() for IP-based
    // throttling. It's written exclusively via the Admin SDK (which bypasses rules),
    // and is already covered by the admin-only catch-all rule below — no new
    // explicit rule needed.

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
