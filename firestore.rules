rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'motsumitl@happyhunterdigital.com' ||
        request.auth.token.email.lower() == 'happyhunterdigital@gmail.com' ||
        request.auth.token.email.lower() == 'motsumitl@gmail.com'
      );
    }

    function isValidEmail(email) {
      return email is string && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') && email.size() <= 254;
    }

    function isValidLeadData() {
      let data = request.resource.data;
      return data.businessName is string && data.businessName.size() <= 200
        && data.email is string && isValidEmail(data.email)
        && data.timestamp != null;
    }

    function isValidProspectData() {
      let data = request.resource.data;
      return data.phone is string && data.phone.size() <= 20
        && data.interest is string && data.interest.size() <= 50;
    }

    function isValidMailData() {
      let data = request.resource.data;
      return data.to is list && data.to.size() > 0 && data.to.size() <= 10
        && data.message != null
        && data.message.subject is string && data.message.subject.size() <= 200;
    }

    function noScriptInjection() {
      let data = request.resource.data;
      let keys = data.keys();
      let result = true;
      for (let key in keys) {
        let val = data[keys[key]];
        if (val is string) {
          result = result && !val.matches('(?i)<script.*>.*</script>')
                   && !val.matches('(?i)javascript:')
                   && !val.matches('(?i)on\\w+\\s*=');
        }
      }
      return result;
    }

    // 1. MULTI-TENANT WORKSPACES
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;
    }

    // 2. WORKSPACE TASK NODES
    match /workspace_tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.workspaceId is string;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'comments', 'priority', 'type', 'deadline', 'assignee', 'assigneePhone', 'coAssignee', 'coAssigneePhone', 'avatar', 'coAvatar']);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid || isAdmin();
    }

    // 3. VISUAL AUDITS (Public trigger, restricted read)
    match /visual_audits/{docId} {
      allow create: if request.resource.data.target is string && request.resource.data.target.size() <= 200;
      allow read: if true; 
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 4. PUBLIC LEAD FORM SUBMISSIONS (with validation)
    match /leads/{leadId} {
      allow create: if isValidLeadData() && noScriptInjection();
      allow read: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 5. WHATSAPP PROSPECTS (with validation)
    match /prospects/{prospectId} {
      allow create: if isValidProspectData() && noScriptInjection();
      allow read: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. MAIL COLLECTION (with validation)
    match /mail/{mailId} {
      allow create: if isValidMailData() && noScriptInjection();
      allow read, update, delete: if false;
    }

    // 7. SECURE ACCESS SESSIONS
    match /secure_access_sessions/{tokenId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // 8. PUBLIC SEO
    match /public_seo/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 9. LIVE CHAT MESSAGES (with content validation)
    match /messages/{messageId} {
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.user is string
        && request.resource.data.user.size() <= 50;
      allow read: if true;
      allow update, delete: if false;
    }

    // 10. LIVE REACTIONS (limited to valid emojis)
    match /reactions/{reactionId} {
      allow create: if request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 10;
      allow read: if true;
      allow update, delete: if false;
    }

    // 11. RATE LIMIT COUNTERS (internal only)
    match /rate_limit_audit/{docId} { allow read, write: if false; }
    match /rate_limit_chat/{docId} { allow read, write: if false; }
    match /rate_limit_service/{docId} { allow read, write: if false; }

    // 12. WHATSAPP SESSIONS (internal only)
    match /whatsapp_sessions/{sessionId} {
      allow read, write: if false;
    }

    // CATCH-ALL: Admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
