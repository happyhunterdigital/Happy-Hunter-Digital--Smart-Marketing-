rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow anyone to create leads (for the audit form)
    match /leads/{leadId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Allow anyone to create mail documents (for the email extension)
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // Audit logs - admin only
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // Live Stream Chat & Reactions required for everyone
    match /messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /reactions/{reactionId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Allow the AI Entity Engine to read the compiled Master Schema
    match /public_seo/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default deny for anything not explicitly stated
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
