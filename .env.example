# 🛡️ IRON DOME: Environment Template
# This file is SAFE to commit - contains only placeholders
# Real secrets are stored in GitHub Actions Secrets only

# ============================================
# FIREBASE CONFIGURATION (Web App)
# ============================================
VITE_FIREBASE_API_KEY=REPLACE_WITH_SECRET
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_SECRET
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_SECRET
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_SECRET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SECRET
VITE_FIREBASE_APP_ID=REPLACE_WITH_SECRET
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_SECRET

# ============================================
# GOOGLE APIs
# ============================================
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=REPLACE_WITH_SECRET

# Get from: https://console.cloud.google.com/apis/credentials
# Restrict to Places API and your domain
VITE_PLACES_API_KEY=REPLACE_WITH_SECRET

# ============================================
# EMAILJS (For audit delivery)
# Get from: https://dashboard.emailjs.com/admin/account
# ============================================
VITE_EMAILJS_PUBLIC_KEY=REPLACE_WITH_SECRET
VITE_EMAILJS_SERVICE_ID=REPLACE_WITH_SECRET
VITE_EMAILJS_TEMPLATE_ID=REPLACE_WITH_SECRET

# ============================================
# FEATURE FLAGS
# ============================================
VITE_USE_EMULATORS=false
