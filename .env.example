# --- Firebase (values come from GitHub Secrets or your local .env) ---
# VITE_FIREBASE_API_KEY=your_google_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=happyhunterdigital.com
VITE_FIREBASE_PROJECT_ID=happy-hunter-systems
VITE_FIREBASE_STORAGE_BUCKET=happy-hunter-systems.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=629161289232
VITE_FIREBASE_APP_ID=1:629161289232:web:17ff042c3f96ecbeb78c95

# --- Firebase App Check (reCAPTCHA Enterprise) ---
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_APP_CHECK_DEBUG_TOKEN=

# --- PostHog ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

