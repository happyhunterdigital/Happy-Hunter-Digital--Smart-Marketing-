# ============================================================
# Happy Hunter Digital — Environment Variables
# Copy this to .env and fill in real values
# ============================================================

# --- Firebase (VITE_ prefix is required by Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=happyhunterdigital.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase App Check (reCAPTCHA Enterprise) ---
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_APP_CHECK_DEBUG_TOKEN=

# --- PostHog ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Cloud Functions Secrets (set via Firebase CLI, NOT this file) ---
# firebase functions:secrets:set GEMINI_API_KEY
# firebase functions:secrets:set PLACES_API_KEY
# firebase functions:secrets:set WHATSAPP_TOKEN
# firebase functions:secrets:set WHATSAPP_APP_SECRET
# firebase functions:secrets:set VERIFY_TOKEN
