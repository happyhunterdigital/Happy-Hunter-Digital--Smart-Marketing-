rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isWorkspaceMember(workspaceId) {
      return firestore.get(/databases/default/documents/workspaces/$(workspaceId)).data.members[request.auth.uid] == true;
    }

    // Visual audits: public read, verified app write only
    match /visual_audits/{fileName} {
      allow read: if true;
      allow write: if request.token.app != null && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // User-scoped uploads: owner only
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workspace-scoped uploads: members only
    match /workspaces/{workspaceId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null && isWorkspaceMember(workspaceId) && request.resource.size < 50 * 1024 * 1024;
    }

    // Temporary uploads: user's own tmp folder
    match /tmp/{userId}/{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}
