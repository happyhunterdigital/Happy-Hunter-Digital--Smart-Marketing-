rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure Visual Audits Folder
    match /visual_audits/{fileName} {
      // Anyone can read the image so the AI and your UI can see it
      allow read: if true;
      
      // Only allow image uploads under 5 Megabytes
      allow write: if request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Default lock down for everything else
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
