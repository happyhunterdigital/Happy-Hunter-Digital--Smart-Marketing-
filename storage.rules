rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure Visual Audits Folder
    match /visual_audits/{fileName} {
      allow read: if true;
      
      // Uploads restricted to Verified Apps AND strict size/type constraints
      allow write: if request.token.app != null 
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Default lock down for everything else
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
